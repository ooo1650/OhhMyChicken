// Cloudflare (Workers with static assets): serves the built site from dist/ and passes
// /api and /media to the backend (worker/index.js). Deploy: `npx wrangler deploy` after
// `npm run build`, with the project's root directory set to frontend/.
{
  "name": "ohhmychicken",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Paths that aren't files (/sizes, /find, /menu/…) get index.html; the app routes them.
    "not_found_handling": "single-page-application",
    // These never come from the files: the Worker sends them to the backend.
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "vars": {
    // Where the API runs (no trailing slash).
    "BACKEND_URL": "https://ohhmychicken.onrender.com"
  }
}
