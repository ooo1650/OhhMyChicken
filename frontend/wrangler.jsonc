// Cloudflare (Workers with static assets) hosting: serves the built site (dist/) and passes
// /api and /media to the backend (worker/index.js). With this folder as the repository's
// top level, Cloudflare's defaults work as they are: `npm run build`, then `npx wrangler deploy`.
{
  "name": "chicken-frontend-pages", // must match the Worker's name in Cloudflare
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  // The site's own domain (and www). Deploys create and keep these; Cloudflare adds the DNS
  // records and the HTTPS certificate. The workers.dev address keeps working for testing.
  "routes": [
    { "pattern": "ohhmychickenpizzahub.com", "custom_domain": true },
    { "pattern": "www.ohhmychickenpizzahub.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Paths that aren't files (/sizes, /find, /menu/…) get index.html; the app routes them.
    "not_found_handling": "single-page-application",
    // These never come from the files: the Worker sends them to the backend.
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "vars": {
    // Where the API runs (no trailing slash).
    "BACKEND_URL": "https://ohhmychicken.onrender.com"
  }
}
