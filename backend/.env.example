# For running the API without Docker (npm run dev). Copy to backend/.env.
PORT=4000
DATABASE_URL=postgres://omc:change-me@localhost:5432/ohh_my_chicken
# Set to true for hosted Postgres that requires SSL (Render, Neon, Supabase…)
PGSSL=false
NODE_ENV=development

# Admin passcode (10+ chars, not easy to guess). Required when NODE_ENV=production; used on
# first start only. Leave empty in development: a random one is printed in the log.
ADMIN_PASSCODE=
SESSION_TTL_HOURS=12
COOKIE_SECURE=
# 1 when a proxy (the frontend server, Vite's dev proxy) sits in front.
TRUST_PROXY=
ALLOWED_ORIGINS=

# Where uploaded photos are stored (default: backend/uploads).
UPLOAD_DIR=
ANALYTICS_TZ=Asia/Kathmandu
ANALYTICS_RETENTION_DAYS=180
