# For running the API without Docker (npm run dev). Copy to backend/.env.
PORT=4000
DATABASE_URL=postgres://omc:change-me@localhost:5432/ohh_my_chicken
# Set to true for hosted Postgres that requires SSL (Render, Neon, Supabase…)
PGSSL=false
NODE_ENV=development

# The first dashboard account and its password (see ../.env.example). Without email set up,
# sign-in codes are printed in this log, which is all you need in development.
SUPER_ADMIN_EMAIL=
ADMIN_PASSCODE=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
COOKIE_SECURE=
# 1 when a proxy (the frontend server, Vite's dev proxy) sits in front.
TRUST_PROXY=
ALLOWED_ORIGINS=

# Where uploaded photos are stored (default: backend/uploads).
UPLOAD_DIR=
ANALYTICS_TZ=Asia/Kathmandu
ANALYTICS_RETENTION_DAYS=180

# The dashboard's Insights tab is a paid extra: true unlocks it.
INSIGHTS_ENABLED=true
