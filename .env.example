# Settings for `docker compose`. Copy to .env and adjust. Never commit .env.
# (For running the backend without Docker, see backend/.env.example.)

# Database password (letters and digits only, so it is safe inside a URL).
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Host port the site is published on.
APP_PORT=3000

# The site's public address. Search engines see it in canonical links, the
# sitemap and social previews, so set it before going live.
PUBLIC_URL=https://your-domain.com
# Set to 1 if a proxy (Caddy, Nginx, a load balancer…) sits in front of the site.
FRONTEND_TRUST_PROXY=

# Initial admin passcode (6+ chars), used only when the database is first seeded.
# Leave empty to use the default "ohh2026", then change it in the dashboard.
ADMIN_PASSCODE=
# URL path of the staff dashboard (default: admin → https://your-site/admin/).
# Pick something hard to guess, e.g. ADMIN_PATH=staff-7f3k, so customers never stumble on it.
ADMIN_PATH=admin
# Admin session length in hours
SESSION_TTL_HOURS=12

# Admin cookies are Secure (HTTPS-only) in production. Browsers allow that on
# http://localhost, but if you serve plain HTTP on a LAN address
# (http://192.168.x.x) set this to false. Never do that on the public internet.
COOKIE_SECURE=

# Proxy hops in front of the backend. The frontend server is one; add one
# more if another proxy (Caddy, a load balancer…) sits in front of it.
TRUST_PROXY=1

# Extra origins allowed to send write requests, comma-separated (rarely needed).
ALLOWED_ORIGINS=
