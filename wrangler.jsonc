// Cloudflare (Workers with static assets) hosting for the frontend: serves the built site
// (frontend/dist) and passes /api and /media to the backend (frontend/worker/index.js).
// Kept at the top of the repository, so Cloudflare's defaults work as they are:
// build command `npm run build` (see package.json here), deploy command `npx wrangler deploy`.
{
  "name": "ohhmychicken",
  "main": "frontend/worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    // Paths that aren't files (/sizes, /find, /menu/…) get index.html; the app routes them.
    "not_found_handling": "single-page-application",
    // These never come from the files: the Worker sends them to the backend.
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "vars": {
    // Where the API runs (no trailing slash).
    "BACKEND_URL": "https://ohhmychicken.onrender.com"
  }
}
